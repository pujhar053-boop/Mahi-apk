<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Outer luminous cyan/violet halo -->
    <path
        android:pathData="M54,28 A26,26 0 1,0 54,80 A26,26 0 1,0 54,28"
        android:strokeWidth="3.0"
        android:fillColor="#158A3FFC">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00E5FF" />
                <item android:offset="0.5" android:color="#FFB388FF" />
                <item android:offset="1.0" android:color="#FFFF4081" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Core Orb -->
    <path
        android:pathData="M54,34 A20,20 0 1,0 54,74 A20,20 0 1,0 54,34">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="34"
                android:endX="68"
                android:endY="74"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF241246" />
                <item android:offset="1.0" android:color="#FF130826" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left Smiling Eye (Curved happy arc) -->
    <path
        android:pathData="M44,48 Q47,43 50,48"
        android:strokeColor="#FF00F0FF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Right Smiling Eye (Curved happy arc) -->
    <path
        android:pathData="M58,48 Q61,43 64,48"
        android:strokeColor="#FFFF4081"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Cheerful gentle smile -->
    <path
        android:pathData="M48,58 Q54,64 60,58"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Soft blush dots -->
    <path
        android:pathData="M42,54 A2,2 0 1,0 42,54.1"
        android:strokeColor="#66FF4081"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#66FF4081" />
    <path
        android:pathData="M66,54 A2,2 0 1,0 66,54.1"
        android:strokeColor="#66FF4081"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#66FF4081" />

    <!-- Subtle futuristic crown accent -->
    <path
        android:pathData="M54,23 L56,26 L54,27 L52,26 Z"
        android:fillColor="#FF00E5FF" />
